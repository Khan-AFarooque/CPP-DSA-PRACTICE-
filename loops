// continue skip give iteration
#include <iostream>
using namespace std;

int main() {

    for(int i = 1; i <= 10; i++) {

        if(i == 5) {
            continue;
        }

        cout << i << " ";
    }

    return 0;
}


pattern printing

// right angle triangle
#include <iostream>
using namespace std;
int main(){
    int n;
    cout<<"enter height of triangle: ";
    cin>>n;
    for(int i=1;i<=n;i++){
        for(int j=1;j<=n-i;j++){
            cout<<" ";
        }
        for(int j=1;j<=i;j++){
            cout<<"*";
        }
        cout<<endl;

    }
}
// pyamid triangle
#include <iostream>
using namespace std;
int main(){
    
    int n;
    cout<<"enter height of triangle: ";
    cin>>n;
    for(int i=n;i>=1;i--){
        for(int j=1;j<=n-i;j++){
            cout<<" ";

        }
        for(int j=1;j<=2*i-1;j++){
            cout<<"*";
        }
        cout<<endl;
    }


    
}

plus print
#include <iostream>
using namespace std;
int main(){
    int n;
    
    cout<<"enter height of plus: ";
    cin>>n;
    int mid = n/2+1;

    for(int i=1;i<=n;i++){

        
        for(int j=1;j<=n;j++){
            if(i==mid || j==mid) cout<<"* ";
            else cout<<"  ";
        }
        cout<<endl;

    }
}







